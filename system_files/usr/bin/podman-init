#!/bin/bash

echo "Inizializzazione dei servizi Podman utente..."

# Abilita e avvia il Socket di Podman
systemctl --user enable --now podman.socket
if systemctl --user is-active --quiet podman.socket; then
    echo "Podman Socket avviato con successo."
else
    echo "Errore nell'avvio di podman.socket" >&2
fi

# Avvia il servizio Podman
systemctl --user start podman.service
if systemctl --user is-active --quiet podman.service; then
    echo "Podman Service avviato con successo."
else
    echo "Errore nell'avvio di podman.service" >&2
fi

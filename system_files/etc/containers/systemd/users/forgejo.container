[Unit]
Requires=forgejo-db.service
After=forgejo-db.service

[Container]
Image=codeberg.org/forgejo/forgejo:latest
ContainerName=forgejo
Network=forgejo.network
PublishPort=3000:3000

# Volumi denominati gestiti da Podman (inclusi i file di fuso orario in sola lettura)
Volume=forgejo_data:/data
Volume=/etc/timezone:/etc/timezone:ro
Volume=/etc/localtime:/etc/localtime:ro

# Variabili d'ambiente
Environment=USER_UID=1000
Environment=USER_GID=1000
Environment=FORGEJO__server__ROOT_URL=http://192.168.122.225
Environment=FORGEJO__server__HTTP_PORT=3000
Environment=FORGEJO__server__DISABLE_SSH=true
Environment=FORGEJO__server__LFS_START_SERVER=true
Environment=FORGEJO__database__DB_TYPE=postgres
Environment=FORGEJO__database__HOST=forgejo-db:5432
Environment=FORGEJO__database__NAME=forgejo
Environment=FORGEJO__database__USER=forgejo
Environment=FORGEJO__database__PASSWD=forgejo
Environment=FORGEJO__service__DISABLE_REGISTRATION=false
Environment=FORGEJO__service__ALLOW_ONLY_EXTERNAL_REGISTRATION=true
Environment=FORGEJO__repository__DEFAULT_BRANCH=main

[Service]
Restart=always

[Install]
WantedBy=default.target
